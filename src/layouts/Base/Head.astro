---
import { SEO } from '@splendidlabz/astro'
import config from '../../../site-config.js'
import Favicon from './Favicon.astro'

const { bodyClass = '', ...props } = Astro.props
---

<SEO site={config.site} {...props} />
<Favicon />

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />

<!-- Reports the first script or island that fails to load -->
<script is:inline>
  {
    const listeners = new AbortController()

    function reportClientError(report) {
      listeners.abort()
      navigator.sendBeacon(
        '/api/client-error/',
        JSON.stringify({ page: location.href, ...report }),
      )
    }

    window.addEventListener(
      'error',
      event => {
        if (!event.target.src?.includes('/_astro/')) return
        reportClientError({ type: 'script', url: event.target.src })
      },
      { capture: true, signal: listeners.signal },
    )

    window.addEventListener(
      'astro:hydration-error',
      event => {
        reportClientError({
          type: 'hydration',
          url: event.detail.componentUrl,
          message: String(event.detail.error),
        })
      },
      { signal: listeners.signal },
    )
  }
</script>

<!-- Fonts -->
<link rel="preconnect" href="https://use.typekit.net" crossorigin />
<link rel="stylesheet" href="https://use.typekit.net/pki5tfy.css" />

<!-- RSS Auto discovery -->
<link
  rel="alternate"
  type="application/rss+xml"
  title="Feed for articles"
  href={new URL('rss.xml', Astro.site)}
/>

<!-- Sitemap -->
<link rel="sitemap" href="/sitemap-index.xml" />

