---
import Base from '@/layouts/Base.astro'
import { getIssues, groupByYear } from '@/utils/newsletter.js'
import { Partial } from '@splendidlabz/astro'
import { getCollection } from 'astro:content'
import { formatDate } from 'date-fns'

const years = groupByYear(getIssues(await getCollection('newsletter')))
const newestYear = years[0]
const olderYear = years[1].year

const SEOProps = {
  title: 'Newsletter',
  description:
    'Join my newsletter to get updates on my latest projects and articles',
}
---

<Base {...SEOProps}>
  <div class="wrap">
    <Partial path="JoinMyNewsletter" testimonialCount={2} />
  </div>

  <div class="wrap mt-section">
    <section class="vertical gap-8 max-w-narrow mx-auto">
      <h2 class="h2">Past issues</h2>

      <div class="vertical gap-2">
        <h3 class="h3 text-zorange-500">{newestYear.year}</h3>
        <div class="blog-list">
          {
            newestYear.issues.map(issue => (
              <div class="blog-list-item">
                <div class="date">{formatDate(issue.data.date, 'dd MMM')}</div>
                <a class="title" href={`/newsletter/${issue.data.slug}/`}>
                  {issue.data.title}
                </a>
              </div>
            ))
          }
        </div>
      </div>

      <a
        class="button button-large py-3 pigment-orange-filled self-start"
        href={`/newsletter/archive/#${olderYear}`}
      >
        See Older Issues
      </a>
    </section>
  </div>

  <div class="mt-section">
    <Partial path="JoinMyNewsletter" />
  </div>
</Base>
