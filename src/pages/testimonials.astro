---
import TestimonialPanel from '@/components/TestimonialPanel.astro'
import Base from '@/layouts/Base.astro'
import { sort } from '@splendidlabz/utils'
import { getCollection } from 'astro:content'

const files = await getCollection('testimonials')
const testimonials = files.map(testimonial => ({
  id: testimonial.id,
  priority: testimonial.data.priority || 0,
}))
const sorted = sort(testimonials, { props: 'priority', reverse: true })

const SEOProps = {
  title: 'Nice Words from Peers, Friends, and Customers',
}
---

<Base {...SEOProps}>
  <section class="section">
    <div class="wrap vertical">
      <div class="article vertical gap-large max-w-standard mx-auto">
        <h1 class="h1 text-center max-w-[14em] mx-auto">
          Nice Words from Peers, Friends, and Customers
        </h1>

        <div
          class="masonry bp6:[--cols:2] bp10:[--cols:3] gap-8 gap-x-6 [--accent-color:var(--color-zorange-500)]"
        >
          {
            sorted.map(testimonial => (
              <TestimonialPanel path={testimonial.id} />
            ))
          }
        </div>
      </div>
    </div>
  </section>
</Base>
