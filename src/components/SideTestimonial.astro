---
import { Image } from '@splendidlabz/astro'
import { toTitle } from '@splendidlabz/utils'
import { getEntry, render } from 'astro:content'

const { path } = Astro.props
const entry = await getEntry('testimonials', path)
const { data } = entry
const { Content } = await render(entry)
const images = import.meta.glob(
  '/src/assets/testimonials/*.{jpeg,jpg,png,webp}',
)

// Prepare variables for use in template
let { title, image, name } = data
if (!image) image = `/src/assets/testimonials/${path}.jpg`
if (!Object.keys(images).some(key => key.startsWith(image))) image = null
if (!name) name = toTitle(path)
---

<blockquote class="quote mt-4 text-9">
  <div class="prose">
    <Content />
  </div>
  <div class="horizontal items-center justify-start gap-3">
    {
      image && (
        <Image
          figureClass="max-w-6"
          class="rounded-full"
          src={image}
          alt={name}
        />
      )
    }
    <div class="text-5 june [--font-style:70]">
      <span class="text-zorange-500">{name}</span>
      {title && <span class="text-zgray-500">— {title}</span>}
    </div>
  </div>
</blockquote>
