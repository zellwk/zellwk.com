---
import { toTitle } from '@splendidlabz/utils'
import { getEntry, render } from 'astro:content'

const { path } = Astro.props
const entry = await getEntry('testimonials', path)
const { data } = entry
const { Content } = await render(entry)

// Prepare variables for use in template
let { title, name } = data
if (!name) name = toTitle(path)
---

<blockquote class="card card-orange vertical gap-2">
  <header class="june text-zorange-500 text-8">
    {name}{' '}
    {title && <span class="text-zgray-500">— {title}</span>}
  </header>
  <div class="prose-tight text-8">
    <Content />
  </div>
</blockquote>
