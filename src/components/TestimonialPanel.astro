---
import { Image } from '@splendidlabz/astro'
import { toTitle } from '@splendidlabz/utils'
import { getEntry, render } from 'astro:content'

const { path } = Astro.props
const entry = await getEntry('testimonials', path)
const { data } = entry
const { Content } = await render(entry)

// Prepare variables for use in template
let { title, name, image } = data
if (!name) name = toTitle(path)
---

<figure class="quote-bar vertical gap-3">
  <blockquote
    class="prose gap-[inherit] [--bold-color:var(--accent-color,var(--color-zviolet-300))] [--bold-weight:500]"
  >
    <Content />
  </blockquote>
  <footer
    class="horizontal items-center gap-3 june text-8 text-[color:var(--accent-color,var(--color-zviolet-300))]"
  >
    {
      image && (
        <Image
          figureClass="max-w-8"
          class="rounded-full"
          src={image}
          alt={name}
        />
      )
    }
    <span>
      {!image && '— '}
      {name}
      {title && <span class="text-zgray-500">— {title}</span>}
    </span>
  </footer>
</figure>
